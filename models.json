        "aspect_ratio": { "kind": "select", "label": "الأبعاد", "options": ["auto", "1:1", "9:16", "16:9", "4:3", "3:4", "3:2", "2:3", "21:9"], "default": "auto", "optionLabels": { "auto": "تلقائي" } },
        "resolution": { "kind": "select", "label": "الدقة", "options": ["1k", "2k", "4k"], "default": "1k" },
        "quality": { "kind": "select", "label": "الجودة", "options": ["low", "medium", "high"], "default": "high", "optionLabels": { "low": "قليلة", "medium": "متوسطة", "high": "عالية" } }
      }
    },
    "kling-3-std-t2v": {
      "label": "Kling 3.0 Standard",
      "type": "video",
      "mode": "نص ← فيديو",
