        "duration": { "kind": "range", "label": "المدة (ثانية)", "min": 3, "max": 15, "default": 5 },
        "sound": { "kind": "select", "label": "الصوت", "options": ["on", "off"], "default": "on", "optionLabels": { "on": "شغال", "off": "مقفول" } }
      }
    },
