        "aspect_ratio": { "kind": "select", "label": "الأبعاد", "options": ["auto", "16:9", "9:16", "1:1", "4:3", "3:4", "21:9", "adaptive"], "default": "auto", "optionLabels": { "auto": "تلقائي", "adaptive": "على حسب المحتوى" } },
        "duration": { "kind": "range", "label": "المدة (ثانية)", "min": 5, "max": 15, "default": 5 }
      }
