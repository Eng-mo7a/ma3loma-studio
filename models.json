{
  "source": "https://docs.higgsfield.ai/docs/llms.txt — schemas checked 2026-09-29",
  "models": {
    "soul-2": {
      "label": "Soul 2",
      "type": "image",
      "mode": "نص ← صورة",
      "endpoint": "/higgsfield-ai/soul/v2/standard",
      "note": "موديل Higgsfield نفسه · أرخص حاجة للتجربة",
      "fields": {
        "prompt": { "kind": "text", "label": "الأمر", "required": true },
        "aspect_ratio": { "kind": "select", "label": "الأبعاد", "options": ["1:1", "16:9", "9:16", "4:3", "3:4", "2:3", "3:2"], "default": "1:1" },
        "resolution": { "kind": "select", "label": "الدقة", "options": ["720p", "1080p"], "default": "720p" },
        "batch_size": { "kind": "select", "label": "عدد الصور", "options": [1, 4], "default": 1 },
        "enhance_prompt": { "kind": "toggle", "label": "خلّي Higgsfield تحسّن الأمر", "default": false }
      }
    },
    "marketing-studio-image": {
      "label": "Marketing Studio Image",
      "type": "image",
      "mode": "نص + صور مرجعية ← صورة إعلان",
      "endpoint": "/marketing-studio/image",
      "note": "لصور الإعلانات · ارفع صورة المنتج كمرجع",
